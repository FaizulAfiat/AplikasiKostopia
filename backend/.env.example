# Salin file ini menjadi .env lalu isi sesuai komputer masing-masing.
# JANGAN commit file .env (sudah ada di .gitignore).

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@localhost:5432/kostopia

# Kunci rahasia JWT: isi dengan string acak panjang (min. 32 karakter), mis. hasil:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG

# Masa berlaku token login (menit)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origin yang diizinkan CORS, pisahkan dengan koma. "*" = semua (aman karena memakai Bearer token).
# Contoh dibatasi: http://localhost,http://localhost:5173,capacitor://localhost
CORS_ORIGINS=*
